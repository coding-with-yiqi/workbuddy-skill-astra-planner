# 复制到 ~/.config/astra-planner.env 或直接在 shell 里 export，按需修改。
# 这个文件里没有任何真实地址或密钥，别把真实值提交进仓库。

# —— 代理：通常不用填 ——
# 留空 = 让 ask_gpt.sh 自己找，顺序是：macOS 系统代理 -> HTTPS_PROXY/HTTP_PROXY/ALL_PROXY。
# 每个候选都会真的连一次 chatgpt.com 验证能通，所以不会挑到一个"存在但其实不通"的代理。
export ASTRA_PROXY=
# 只有当代理不在系统设置里（Linux、CI，或端口是手工起的）才显式指定：
# export ASTRA_PROXY=http://<你的代理地址>:<端口>

# 模型与推理档位（默认 gpt-6-astra / xhigh，一般不用改）
# export ASTRA_MODEL=gpt-6-astra
# export ASTRA_EFFORT=xhigh

# Codex 沙箱策略：read-only（默认）/ workspace-write / danger-full-access
# export ASTRA_SANDBOX=read-only

# 设为 1 则不保留 Codex 会话记录（默认保留，便于事后查 session）
# export ASTRA_EPHEMERAL=1

# 只想指定 codex 路径时才设（默认按 PATH 查找）
# export CODEX_BIN=/path/to/codex
